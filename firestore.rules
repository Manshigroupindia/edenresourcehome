rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global website settings: public read, authenticated admin write
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Gallery images: public read, authenticated admin write
    match /gallery/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Site statistics (visitor counter):
    // Public read: anyone can read the visitor count.
    // Public increment: unauthenticated users may only increment visitors count by 1 or initialize it.
    // Authenticated admin: full read/write/delete access.
    match /siteStats/{docId} {
      allow read: if true;
      allow create: if request.auth != null || (
        docId == 'visitors' &&
        request.resource.data.keys().hasOnly(['count', 'updatedAt']) &&
        request.resource.data.count is int &&
        request.resource.data.count >= 1
      );
      allow update: if request.auth != null || (
        docId == 'visitors' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt']) &&
        request.resource.data.count == resource.data.count + 1
      );
      allow delete: if request.auth != null;
    }

    // Default catch-all rule: require authentication for any other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
