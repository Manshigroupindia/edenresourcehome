rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global website settings: public read, authenticated admin write
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Gallery images: public read, authenticated admin write
    match /gallery/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default catch-all rule: require authentication for any other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
